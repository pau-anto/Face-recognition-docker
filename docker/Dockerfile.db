# =========================================================
# Dockerfile.db — MySQL 8.0
# Harry Potter Face Recognition
# BD : hp_recognition | User : wpuser | Port : 3306
# =========================================================

FROM mysql:8.0


# ── Variables d'environnement MySQL ───────────────────────
# Ces valeurs peuvent être surchargées via docker-compose ou --env-file
ENV MYSQL_ROOT_PASSWORD=root_password
ENV MYSQL_DATABASE=hp_recognition
ENV MYSQL_USER=wpuser
ENV MYSQL_PASSWORD=wppass

# ── Encodage UTF-8 (accents dans les noms de personnages) ──
ENV LANG=C.UTF-8

# ── Script d'initialisation ───────────────────────────────
COPY database/schema.sql /docker-entrypoint-initdb.d/schema.sql



# ── Port exposé ───────────────────────────────────────────
EXPOSE 3306

# ── Volume de persistance ─────────────────────────────────
# À monter via docker-compose pour persister les données
# entre les redémarrages du container.
VOLUME ["/var/lib/mysql"]

# ── Healthcheck ───────────────────────────────────────────
# Vérifie que MySQL est prêt à accepter des connexions.
# L'app attendra ce statut "healthy" avant de démarrer (via docker-compose).
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD mysqladmin ping -h localhost -u"${MYSQL_USER}" -p"${MYSQL_PASSWORD}" --silent

# ── CMD ───────────────────────────────────────────────────
# Héritée de l'image mysql:8.0 : lance mysqld
# CMD ["mysqld"]
